generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  users       User[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  module      String   @db.VarChar(50)
  description String?
  roles       RolePermission[]
  @@map("permissions")
}

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")
  role         Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           BigInt   @id @default(autoincrement())
  roleId       BigInt   @map("role_id")
  username     String   @unique @db.VarChar(80)
  email        String?  @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employee     Employee?
  createdOrders Order[] @relation("OrderCreator")
  confirmedOrders Order[] @relation("OrderConfirmer")
  orderHistory OrderStatusHistory[]
  itemHistory  OrderItemStatusHistory[]
  openedSessions DiningSession[] @relation("SessionOpener")
  closedSessions DiningSession[] @relation("SessionCloser")
  stockMovements StockMovement[]
  shortageReports ShortageReport[]
  openingChecks DailyInventoryRecord[] @relation("OpeningChecker")
  closingChecks DailyInventoryRecord[] @relation("ClosingChecker")
  payments Payment[]
  @@map("users")
}

model Employee {
  id               BigInt   @id @default(autoincrement())
  userId            BigInt   @unique @map("user_id")
  employeeCode      String   @unique @map("employee_code") @db.VarChar(30)
  fullName          String   @map("full_name") @db.VarChar(150)
  phone             String?  @db.VarChar(20)
  employmentStatus  String   @default("ACTIVE") @map("employment_status") @db.VarChar(20)
  hiredAt           DateTime? @map("hired_at") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("employees")
}

model MenuCategory {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  items       MenuItem[]
  @@map("menu_categories")
}

model KitchenStation {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  menuItems   MenuItem[]
  orders      Order[]
  tickets     KitchenTicket[]
  @@map("kitchen_stations")
}

model MenuItem {
  id                BigInt   @id @default(autoincrement())
  categoryId        BigInt   @map("category_id")
  kitchenStationId  BigInt   @map("kitchen_station_id")
  code              String   @unique @db.VarChar(40)
  name              String   @db.VarChar(150)
  description       String?
  price             Decimal  @db.Decimal(14, 2)
  imageUrl          String?  @map("image_url") @db.VarChar(1000)
  availabilityStatus String @default("AVAILABLE") @map("availability_status") @db.VarChar(30)
  availabilityReason String? @map("availability_reason")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  category          MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  kitchenStation    KitchenStation @relation(fields: [kitchenStationId], references: [id], onDelete: Restrict)
  orderItems        OrderItem[]
  ingredients       MenuItemIngredient[]
  @@unique([id, kitchenStationId])
  @@index([availabilityStatus, categoryId])
  @@index([kitchenStationId])
  @@map("menu_items")
}

model DiningTable {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(80)
  capacity    Int?
  status      String   @default("AVAILABLE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions    DiningSession[]
  devices     TableDevice[]
  orders      Order[]
  @@map("dining_tables")
}

model DiningSession {
  id            BigInt   @id @default(autoincrement())
  tableId       BigInt   @map("table_id")
  sessionCode   String   @unique @map("session_code") @db.VarChar(80)
  tokenHash     String?  @map("token_hash") @db.VarChar(255)
  status        String   @default("OPEN") @db.VarChar(20)
  openedBy      BigInt?  @map("opened_by")
  closedBy      BigInt?  @map("closed_by")
  openedAt      DateTime @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(6)
  table         DiningTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  opener        User? @relation("SessionOpener", fields: [openedBy], references: [id], onDelete: Restrict)
  closer        User? @relation("SessionCloser", fields: [closedBy], references: [id], onDelete: Restrict)
  orders        Order[]
  @@index([tableId, status])
  @@map("dining_sessions")
}

model TableDevice {
  id            BigInt   @id @default(autoincrement())
  diningTableId BigInt   @map("dining_table_id")
  deviceCode    String   @unique @map("device_code") @db.VarChar(100)
  deviceName    String   @map("device_name") @db.VarChar(120)
  tokenHash     String?  @map("token_hash") @db.VarChar(255)
  status        String   @default("ACTIVE") @db.VarChar(20)
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  table         DiningTable @relation(fields: [diningTableId], references: [id], onDelete: Restrict)
  @@index([diningTableId, status])
  @@map("table_devices")
}

model Customer {
  id           BigInt   @id @default(autoincrement())
  displayName  String   @map("display_name") @db.VarChar(150)
  email        String?  @unique @db.VarChar(255)
  phone        String?  @unique @db.VarChar(20)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  status       String   @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  orders       Order[]
  @@map("customers")
}

model Order {
  id                 BigInt   @id @default(autoincrement())
  orderCode          String   @unique @map("order_code") @db.VarChar(40)
  orderType          String   @map("order_type") @db.VarChar(20)
  status             String   @default("PENDING_CONFIRMATION") @db.VarChar(30)
  diningTableId      BigInt?  @map("dining_table_id")
  diningSessionId    BigInt?  @map("dining_session_id")
  customerId         BigInt?  @map("customer_id")
  kitchenStationId   BigInt   @map("kitchen_station_id")
  guestCount         Int?     @map("guest_count")
  createdBy          BigInt?  @map("created_by")
  confirmedBy        BigInt?  @map("confirmed_by")
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(6)
  dispatchedAt       DateTime? @map("dispatched_at") @db.Timestamptz(6)
  rejectionReason    String?  @map("rejection_reason")
  note               String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  table              DiningTable? @relation(fields: [diningTableId], references: [id], onDelete: Restrict)
  diningSession      DiningSession? @relation(fields: [diningSessionId], references: [id], onDelete: Restrict)
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  kitchenStation     KitchenStation @relation(fields: [kitchenStationId], references: [id], onDelete: Restrict)
  creator            User? @relation("OrderCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  confirmer          User? @relation("OrderConfirmer", fields: [confirmedBy], references: [id], onDelete: Restrict)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  kitchenTicket      KitchenTicket?
  payment            Payment?
  @@unique([id, kitchenStationId])
  @@index([status, createdAt(sort: Desc)])
  @@index([diningTableId, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id                BigInt   @id @default(autoincrement())
  orderId           BigInt   @map("order_id")
  menuItemId        BigInt   @map("menu_item_id")
  kitchenStationId  BigInt   @map("kitchen_station_id")
  itemNameSnapshot  String   @map("item_name_snapshot") @db.VarChar(150)
  quantity          Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal         Decimal  @map("line_total") @db.Decimal(14, 2)
  note              String?
  status            String   @default("PENDING_CONFIRMATION") @db.VarChar(30)
  terminalReason    String?  @map("terminal_reason")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  order             Order @relation(fields: [orderId, kitchenStationId], references: [id, kitchenStationId], onDelete: Restrict)
  menuItem          MenuItem @relation(fields: [menuItemId, kitchenStationId], references: [id, kitchenStationId], onDelete: Restrict)
  kitchenStation    KitchenStation @relation(fields: [kitchenStationId], references: [id], onDelete: Restrict)
  history           OrderItemStatusHistory[]
  @@index([orderId, status])
  @@map("order_items")
}

model OrderStatusHistory {
  id          BigInt   @id @default(autoincrement())
  orderId     BigInt   @map("order_id")
  fromStatus  String?  @map("from_status") @db.VarChar(30)
  toStatus    String   @map("to_status") @db.VarChar(30)
  reason      String?
  actorId     BigInt?  @map("actor_id")
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  order       Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor       User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([orderId, changedAt(sort: Desc)])
  @@map("order_status_history")
}

model OrderItemStatusHistory {
  id          BigInt   @id @default(autoincrement())
  orderItemId BigInt   @map("order_item_id")
  fromStatus  String?  @map("from_status") @db.VarChar(30)
  toStatus    String   @map("to_status") @db.VarChar(30)
  reason      String?
  actorId     BigInt?  @map("actor_id")
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  actor       User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([orderItemId, changedAt(sort: Desc)])
  @@map("order_item_status_history")
}

model KitchenTicket {
  id               BigInt   @id @default(autoincrement())
  orderId          BigInt   @unique @map("order_id")
  kitchenStationId BigInt   @map("kitchen_station_id")
  status           String   @default("QUEUED") @db.VarChar(20)
  dispatchedAt     DateTime @default(now()) @map("dispatched_at") @db.Timestamptz(6)
  order            Order @relation(fields: [orderId, kitchenStationId], references: [id, kitchenStationId], onDelete: Restrict)
  station          KitchenStation @relation(fields: [kitchenStationId], references: [id], onDelete: Restrict)
  @@index([kitchenStationId, status, dispatchedAt])
  @@map("kitchen_tickets")
}

model Ingredient {
  id                 BigInt   @id @default(autoincrement())
  code               String   @unique @db.VarChar(40)
  name               String   @db.VarChar(120)
  unit               String   @db.VarChar(30)
  lowStockThreshold  Decimal? @map("low_stock_threshold") @db.Decimal(14, 3)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  balance            InventoryBalance?
  movements          StockMovement[]
  shortages          ShortageReport[]
  menuItems          MenuItemIngredient[]
  dailyRecords       DailyInventoryRecord[]
  @@map("ingredients")
}

model InventoryBalance {
  ingredientId   BigInt   @id @map("ingredient_id")
  quantityOnHand Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(14, 3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  @@map("inventory_balances")
}

model StockMovement {
  id             BigInt   @id @default(autoincrement())
  ingredientId   BigInt   @map("ingredient_id")
  movementType   String   @map("movement_type") @db.VarChar(20)
  quantityDelta  Decimal  @map("quantity_delta") @db.Decimal(14, 3)
  reason         String
  referenceCode  String?  @map("reference_code") @db.VarChar(80)
  createdBy      BigInt   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  actor          User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([ingredientId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

model ShortageReport {
  id            BigInt   @id @default(autoincrement())
  orderItemId   BigInt?  @map("order_item_id")
  ingredientId  BigInt?  @map("ingredient_id")
  reportedBy    BigInt   @map("reported_by")
  reason        String
  status        String   @default("OPEN") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  orderItem     OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  ingredient    Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  reporter      User @relation(fields: [reportedBy], references: [id], onDelete: Restrict)
  @@index([status, createdAt(sort: Desc)])
  @@map("shortage_reports")
}

model MenuItemIngredient {
  menuItemId  BigInt @map("menu_item_id")
  ingredientId BigInt @map("ingredient_id")
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  ingredient  Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  @@id([menuItemId, ingredientId])
  @@map("menu_item_ingredients")
}

model DailyInventoryRecord {
  id                  BigInt   @id @default(autoincrement())
  ingredientId        BigInt   @map("ingredient_id")
  inventoryDate       DateTime @map("inventory_date") @db.Date
  openingQuantity     Decimal? @map("opening_quantity") @db.Decimal(14, 3)
  closingQuantity     Decimal? @map("closing_quantity") @db.Decimal(14, 3)
  openingNote         String?  @map("opening_note")
  closingNote         String?  @map("closing_note")
  openingCheckedBy    BigInt?  @map("opening_checked_by")
  closingCheckedBy    BigInt?  @map("closing_checked_by")
  openingCheckedAt    DateTime? @map("opening_checked_at") @db.Timestamptz(6)
  closingCheckedAt    DateTime? @map("closing_checked_at") @db.Timestamptz(6)
  ingredient          Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  openingChecker      User? @relation("OpeningChecker", fields: [openingCheckedBy], references: [id], onDelete: Restrict)
  closingChecker      User? @relation("ClosingChecker", fields: [closingCheckedBy], references: [id], onDelete: Restrict)
  @@unique([ingredientId, inventoryDate])
  @@index([inventoryDate])
  @@map("daily_inventory_records")
}

model Payment {
  id            BigInt   @id @default(autoincrement())
  orderId       BigInt   @unique @map("order_id")
  amount        Decimal  @db.Decimal(14, 2)
  paymentMethod String   @map("payment_method") @db.VarChar(40)
  status        String   @default("PAID") @db.VarChar(20)
  transactionRef String? @map("transaction_ref") @db.VarChar(120)
  paidAt        DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  recordedBy    BigInt   @map("recorded_by")
  order         Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor         User @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  @@index([paidAt(sort: Desc)])
  @@map("payments")
}
