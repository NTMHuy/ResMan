@startuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 90
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #A16207
}

' ===== BÊN TRÁI (2 actor) =====
actor "Khách hàng\n(CUSTOMER)" as Customer
actor "Nhân viên Order" as OrderStaff

' ===== BÊN PHẢI (3 actor) =====
actor "Nhân viên Bếp" as Kitchen
actor "Nhân viên Kho" as Inventory
actor "Quản lý" as Manager

rectangle "ResMan" {

  rectangle "Xác thực và thực đơn" as G1 {
    usecase "UC-01\nĐăng nhập" as UC01
    usecase "UC-02\nXem thực đơn" as UC02
  }

  rectangle "Phiên, gọi món và thanh toán" as G2 {
    usecase "UC-03\nMở phiên" as UC03
    usecase "UC-04\nGọi món" as UC04
    usecase "UC-05\nTheo dõi đơn/món" as UC05
    usecase "UC-06\nHủy món" as UC06
    usecase "UC-11\nYêu cầu thanh toán" as UC11
    usecase "UC-12\nXác nhận thanh toán" as UC12
  }

  rectangle "Vận hành" as G3 {
    usecase "UC-07\nQuản lý bàn" as UC07
    usecase "UC-09\nXử lý KDS" as UC09
    usecase "UC-10\nQuản lý kho" as UC10
  }

  rectangle "Quản trị và báo cáo" as G4 {
    usecase "UC-08\nQuản lý thực đơn" as UC08
    usecase "UC-13\nQuản lý tài khoản" as UC13
    usecase "UC-14\nXem báo cáo" as UC14
    usecase "UC-15\nTra cứu nhật ký kiểm toán\n(Đề xuất)" as UC15
  }
}

' ===== Bố cục: ép thứ tự các nhóm từ trái sang phải =====
G1 -[hidden]right- G2
G2 -[hidden]right- G3
G3 -[hidden]right- G4

' ===== Actor bên trái -> use case =====
Customer -- UC01
Customer -- UC02
Customer -- UC03
Customer -- UC04
Customer -- UC05
Customer -- UC06
Customer -- UC11

OrderStaff -- UC01
OrderStaff -- UC02
OrderStaff -- UC03
OrderStaff -- UC04
OrderStaff -- UC05
OrderStaff -- UC06
OrderStaff -- UC07
OrderStaff -- UC12

' ===== Actor bên phải (viết use case trước để actor nằm bên phải) =====
UC01 -- Kitchen
UC06 -- Kitchen
UC09 -- Kitchen

UC01 -- Inventory
UC10 -- Inventory

UC01 -- Manager
UC02 -- Manager
UC03 -- Manager
UC04 -- Manager
UC05 -- Manager
UC06 -- Manager
UC07 -- Manager
UC08 -- Manager
UC09 -- Manager
UC10 -- Manager
UC12 -- Manager
UC13 -- Manager
UC14 -- Manager
UC15 -- Manager

note bottom of UC15
  Đề xuất để đáp ứng phần tra cứu của FR-24.
  Hiện chưa có endpoint/controller đọc AuditLog.
end note
@enduml
