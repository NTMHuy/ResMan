flowchart TD
  A([Bắt đầu]) --> B["Nhập username/password"]
  B --> C["POST /api/v1/auth/login"]
  C --> D["AuthService.login()"]
  D --> E{"User tồn tại, hoạt động<br/>và mật khẩu hợp lệ?"}
  E -- Không --> F["HTTP 401 Unauthorized"]
  F --> G([Kết thúc thất bại])
  E -- Có --> H["Cập nhật lastLoginAt"]
  H --> I["Tạo JWT, trả user/role/permissions"]
  I --> J["Cập nhật AuthContext"]
  J --> K["Điều hướng theo role"]
  K --> L([Kết thúc thành công])