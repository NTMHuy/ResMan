
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
  "moduleResolution": "Node10",
"ignoreDeprecations": "6.0"
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": false,
    "incremental": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts"
  ]
}
