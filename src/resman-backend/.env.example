
PORT=3000
API_PREFIX=api/v1

# PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/resman?schema=public"

# JWT Access Token
JWT_ACCESS_SECRET="your-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

# JWT Authentication
JWT_SECRET="your-jwt-secret"
JWT_EXPIRES_IN="1d"

# JWT Refresh Token
JWT_REFRESH_SECRET="your-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"
FRONTEND_ORIGIN="http://localhost:3000,http://localhost:5173"

# Logging
LOG_LEVEL=debug

# Initial manager (used only by the one-time seed command)
INITIAL_ADMIN_USERNAME=manager
INITIAL_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
INITIAL_ADMIN_FULL_NAME=Restaurant Manager
INITIAL_ADMIN_EMPLOYEE_CODE=EMP001
