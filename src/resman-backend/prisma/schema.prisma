generator client {
  provider = "prisma-client"
  output   = "../backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          BigInt           @id @default(autoincrement())
  code        String           @unique @db.VarChar(40)
  name        String           @db.VarChar(100)
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          BigInt           @id @default(autoincrement())
  code        String           @unique @db.VarChar(80)
  name        String           @db.VarChar(120)
  module      String           @db.VarChar(50)
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt     @map("role_id")
  permissionId BigInt     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id              BigInt                   @id @default(autoincrement())
  roleId          BigInt                   @map("role_id")
  username        String                   @unique @db.VarChar(80)
  email           String?                  @unique @db.VarChar(255)
  passwordHash    String                   @map("password_hash") @db.VarChar(255)
  isActive        Boolean                  @default(true) @map("is_active")
  lastLoginAt     DateTime?                @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  role            Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employee        Employee?
  openedSessions  DiningSession[]          @relation("SessionOpener")
  closedSessions  DiningSession[]          @relation("SessionCloser")
  itemHistory     OrderItemStatusHistory[]
  stockMovements  StockMovement[]
  inventoryCounts InventoryCountRecord[]
  payments        Payment[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Employee {
  id               BigInt    @id @default(autoincrement())
  userId           BigInt    @unique @map("user_id")
  employeeCode     String    @unique @map("employee_code") @db.VarChar(30)
  fullName         String    @map("full_name") @db.VarChar(150)
  phone            String?   @db.VarChar(20)
  employmentStatus String    @default("ACTIVE") @map("employment_status") @db.VarChar(20)
  hiredAt          DateTime? @map("hired_at") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("employees")
}

model MenuCategory {
  id          BigInt     @id @default(autoincrement())
  code        String     @unique @db.VarChar(40)
  name        String     @db.VarChar(100)
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  items       MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id                 BigInt       @id @default(autoincrement())
  categoryId         BigInt       @map("category_id")
  code               String       @unique @db.VarChar(40)
  name               String       @db.VarChar(150)
  description        String?
  price              Decimal      @db.Decimal(14, 2)
  imageUrl           String?      @map("image_url") @db.VarChar(1000)
  availabilityStatus String       @default("AVAILABLE") @map("availability_status") @db.VarChar(30)
  availabilityReason String?      @map("availability_reason")
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  category           MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems         OrderItem[]

  @@index([availabilityStatus, categoryId])
  @@index([isActive, categoryId])
  @@map("menu_items")
}

model DiningTable {
  id        BigInt          @id @default(autoincrement())
  code      String          @unique @db.VarChar(30)
  name      String          @db.VarChar(80)
  capacity  Int?
  status    String          @default("AVAILABLE") @db.VarChar(20)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions  DiningSession[]
  devices   TableDevice[]

  @@map("dining_tables")
}

model DiningSession {
  id          BigInt      @id @default(autoincrement())
  tableId     BigInt      @map("table_id")
  sessionCode String      @unique @map("session_code") @db.VarChar(80)
  status      String      @default("OPEN") @db.VarChar(20)
  openedBy    BigInt?     @map("opened_by")
  closedBy    BigInt?     @map("closed_by")
  openedAt    DateTime    @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt    DateTime?   @map("closed_at") @db.Timestamptz(6)
  table       DiningTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  opener      User?       @relation("SessionOpener", fields: [openedBy], references: [id], onDelete: Restrict)
  closer      User?       @relation("SessionCloser", fields: [closedBy], references: [id], onDelete: Restrict)
  order       Order?

  @@index([tableId, status])
  @@map("dining_sessions")
}

model TableDevice {
  id            BigInt      @id @default(autoincrement())
  diningTableId BigInt      @map("dining_table_id")
  deviceCode    String      @unique @map("device_code") @db.VarChar(100)
  deviceName    String      @map("device_name") @db.VarChar(120)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  table         DiningTable @relation(fields: [diningTableId], references: [id], onDelete: Restrict)

  @@index([diningTableId, isActive])
  @@map("table_devices")
}

model Order {
  id              BigInt        @id @default(autoincrement())
  orderCode       String        @unique @map("order_code") @db.VarChar(40)
  diningSessionId BigInt        @unique @map("dining_session_id")
  note            String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  diningSession   DiningSession @relation(fields: [diningSessionId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  payment         Payment?

  @@map("orders")
}

model OrderItem {
  id               BigInt                   @id @default(autoincrement())
  orderId          BigInt                   @map("order_id")
  menuItemId       BigInt                   @map("menu_item_id")
  itemNameSnapshot String                   @map("item_name_snapshot") @db.VarChar(150)
  quantity         Int
  unitPrice        Decimal                  @map("unit_price") @db.Decimal(14, 2)
  lineTotal        Decimal                  @map("line_total") @db.Decimal(14, 2)
  note             String?
  status           String                   @default("AWAITING_ACCEPTANCE") @db.VarChar(30)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  order            Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  menuItem         MenuItem                 @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  history          OrderItemStatusHistory[]

  @@index([orderId, status])
  @@index([status, createdAt])
  @@map("order_items")
}

model OrderItemStatusHistory {
  id          BigInt    @id @default(autoincrement())
  orderItemId BigInt    @map("order_item_id")
  fromStatus  String?   @map("from_status") @db.VarChar(30)
  toStatus    String    @map("to_status") @db.VarChar(30)
  reason      String?
  actorId     BigInt?   @map("actor_id")
  changedAt   DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([orderItemId, changedAt(sort: Desc)])
  @@map("order_item_status_history")
}

model Ingredient {
  id                BigInt                 @id @default(autoincrement())
  code              String                 @unique @db.VarChar(40)
  name              String                 @db.VarChar(120)
  category          String?                @db.VarChar(80)
  unit              String                 @db.VarChar(30)
  lowStockThreshold Decimal?               @map("low_stock_threshold") @db.Decimal(14, 3)
  note              String?
  isActive          Boolean                @default(true) @map("is_active")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  balance           InventoryBalance?
  movements         StockMovement[]
  countRecords      InventoryCountRecord[]

  @@map("ingredients")
}

model InventoryBalance {
  ingredientId   BigInt     @id @map("ingredient_id")
  quantityOnHand Decimal    @default(0) @map("quantity_on_hand") @db.Decimal(14, 3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@map("inventory_balances")
}

model StockMovement {
  id            BigInt     @id @default(autoincrement())
  ingredientId  BigInt     @map("ingredient_id")
  movementType  String     @map("movement_type") @db.VarChar(20)
  quantityDelta Decimal    @map("quantity_delta") @db.Decimal(14, 3)
  reason        String
  referenceCode String?    @map("reference_code") @db.VarChar(80)
  createdBy     BigInt     @map("created_by")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  actor         User       @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([ingredientId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

model InventoryCountRecord {
  id             BigInt     @id @default(autoincrement())
  ingredientId   BigInt     @map("ingredient_id")
  actualQuantity Decimal    @map("actual_quantity") @db.Decimal(14, 3)
  countedAt      DateTime   @default(now()) @map("counted_at") @db.Timestamptz(6)
  countedBy      BigInt     @map("counted_by")
  note           String?
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  actor          User       @relation(fields: [countedBy], references: [id], onDelete: Restrict)

  @@index([ingredientId, countedAt(sort: Desc)])
  @@index([countedAt(sort: Desc)])
  @@map("inventory_count_records")
}

model Payment {
  id             BigInt   @id @default(autoincrement())
  orderId        BigInt   @unique @map("order_id")
  amount         Decimal  @db.Decimal(14, 2)
  paymentMethod  String?  @map("payment_method") @db.VarChar(40)
  status         String   @default("PAID") @db.VarChar(20)
  transactionRef String?  @map("transaction_ref") @db.VarChar(120)
  paidAt         DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  recordedBy     BigInt   @map("recorded_by")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor          User     @relation(fields: [recordedBy], references: [id], onDelete: Restrict)

  @@index([paidAt(sort: Desc)])
  @@map("payments")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt?  @map("actor_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String   @map("entity_id") @db.VarChar(100)
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}
