{
  "name": "resman-backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "prisma:format": "prisma format --config ./prisma.config.ts",
    "prisma:validate": "prisma validate --config ./prisma.config.ts",
    "prisma:generate": "prisma generate --config ./prisma.config.ts",
    "prisma:migrate:create": "prisma migrate dev --create-only --name init_resman --config ./prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config ./prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config ./prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^16.4.7",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "prisma": "^7.0.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
