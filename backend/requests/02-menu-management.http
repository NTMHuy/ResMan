@baseUrl = http://localhost:3000/api/v1
@token = {{accessToken}}

### 1. Danh sách danh mục
GET {{baseUrl}}/menu-categories
Authorization: Bearer {{token}}

### 2. Tạo danh mục
# @name createCategory
POST {{baseUrl}}/menu-categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "QA_MENU_CATEGORY",
  "name": "Danh mục kiểm thử",
  "description": "Danh mục dùng để kiểm thử API ResMan"
}

### 3. Danh sách món quản lý (có tìm kiếm, lọc, phân trang)
GET {{baseUrl}}/menu-items?search=&page=1&limit=100
Authorization: Bearer {{token}}

### 4. Tạo món giá cố định
# @name createFixedItem
POST {{baseUrl}}/menu-items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "QA_FIXED_01",
  "categoryId": {{createCategory.response.body.$.id}},
  "name": "Món giá cố định",
  "description": "Món dùng để kiểm thử loại giá FIXED",
  "price": 45000,
  "pricingType": "FIXED"
}

### 5. Tạo món giá theo đơn vị (ví dụ theo lạng)
# @name createPerUnitItem
POST {{baseUrl}}/menu-items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "QA_PER_UNIT_01",
  "categoryId": {{createCategory.response.body.$.id}},
  "name": "Món tính theo lạng",
  "description": "Món dùng để kiểm thử loại giá PER_UNIT",
  "price": 25000,
  "pricingType": "PER_UNIT",
  "priceUnit": "lạng"
}

### 6. Tạo món giá thị trường (không có giá)
# @name createMarketPriceItem
POST {{baseUrl}}/menu-items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "QA_MARKET_01",
  "categoryId": {{createCategory.response.body.$.id}},
  "name": "Món giá thị trường",
  "description": "Món dùng để kiểm thử loại giá MARKET_PRICE",
  "price": null,
  "pricingType": "MARKET_PRICE"
}

### 7. Tạo món chưa thiết lập giá
# @name createUnsetItem
POST {{baseUrl}}/menu-items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "QA_UNSET_01",
  "categoryId": {{createCategory.response.body.$.id}},
  "name": "Món chưa có giá",
  "description": "Món dùng để kiểm thử loại giá UNSET",
  "price": null,
  "pricingType": "UNSET"
}

### 8. Cập nhật trạng thái món (hết món)
PATCH {{baseUrl}}/menu-items/{{createFixedItem.response.body.$.id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": true,
  "availabilityStatus": "MANUAL_UNAVAILABLE",
  "availabilityReason": "Hết món kiểm thử"
}

### 9. Khôi phục trạng thái món
PATCH {{baseUrl}}/menu-items/{{createFixedItem.response.body.$.id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": true,
  "availabilityStatus": "AVAILABLE",
  "availabilityReason": null
}

### 10. Thực đơn công khai dành cho khách hàng
GET {{baseUrl}}/menu-items/customer/menu

### 11. Xóa danh mục kiểm thử (chỉ thành công sau khi đã xóa các món kiểm thử)
DELETE {{baseUrl}}/menu-categories/{{createCategory.response.body.$.id}}
Authorization: Bearer {{token}}
