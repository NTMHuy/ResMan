
@baseUrl = http://localhost:3000/api/v1

# Lấy sessionCode từ response của request 3.5
@sessionCode = b350c4f49bb8be21577c0725b030abbdc46092cd10620ede32854a4cec4983c8

# Lấy menuItemId từ response của request 4.1
@menuItemId = 1

### 4.1 - Khách xem thực đơn
# Expected: 200 OK
# Có danh sách danh mục và các món đang hoạt động, còn khả dụng.

GET {{baseUrl}}/menu


### 4.2 - Khách xem phiên bàn
# Expected: 200 OK
# Trả về thông tin session, table và items (ban đầu có thể là []).

GET {{baseUrl}}/guest/session
X-Session-Code: {{sessionCode}}


### 4.3 - Khách gọi món
# Expected: 201 Created
# Món mới có trạng thái AWAITING_ACCEPTANCE.

POST {{baseUrl}}/guest/session/items
Content-Type: application/json
X-Session-Code: {{sessionCode}}

{
  "items": [
    {
      "menuItemId": {{menuItemId}},
      "quantity": 2,
      "note": "Ít cay"
    }
  ]
}


### 4.4 - Kiểm tra món vừa gọi
# Expected: 200 OK
# Có món vừa gọi, số lượng 2, ghi chú "Ít cay".

GET {{baseUrl}}/guest/session
X-Session-Code: {{sessionCode}}


### 4.5 - Khách hủy món trước khi bếp tiếp nhận
# Expected: 200 OK
# Trạng thái món chuyển thành CANCELLED.
# Lấy itemId từ response của request 4.3.

@itemId = 2

DELETE {{baseUrl}}/guest/session/items/{{itemId}}
X-Session-Code: {{sessionCode}}


### 4.6 - Kiểm tra trạng thái sau khi hủy
# Expected: 200 OK
# Món vẫn xuất hiện trong danh sách nhưng có status CANCELLED.

GET {{baseUrl}}/guest/session
X-Session-Code: {{sessionCode}}
