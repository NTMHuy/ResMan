{
    "expo": {
        "name": "ResMan",
        "slug": "resman-mobile",
        "version": "1.0.0",
        "orientation": "default",
        "scheme": "resman",
        "userInterfaceStyle": "automatic",
        "platforms": ["ios", "android", "web"],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.resman.app"
        },
        "android": {
            "package": "com.resman.app"
        },
        "web": {
            "bundler": "metro",
            "output": "single"
        },
        "plugins": [
            "expo-router",
            "expo-status-bar"
        ]
    }
}