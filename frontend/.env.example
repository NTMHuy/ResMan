# Backend API
# Use the computer's LAN IP when testing on a physical phone, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1
# Android emulator fallback is handled by app config (10.0.2.2).
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Giai đoạn 1: đăng nhập bằng Backend thật.
EXPO_PUBLIC_USE_MOCK_AUTH=false

# Các module chưa tích hợp có thể tiếp tục dùng mock.
EXPO_PUBLIC_USE_MOCK_DATA=true

# Gọi món khách hàng luôn dùng Backend thật (chỉ bật mock khi chủ động đặt true).
EXPO_PUBLIC_USE_MOCK_CUSTOMER_ORDER=false

# Menu Management must use the real Backend.
EXPO_PUBLIC_USE_MOCK_MENU=false
